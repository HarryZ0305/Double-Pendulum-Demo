  <!-- ================= TAB 2 ================= -->
  <section class="tab" id="t2">
    <div class="controls">
      <div class="ctl">
        <label>Drop angle · <span class="val" id="ang2v">120°</span></label>
        <input type="range" id="ang2" min="5" max="170" step="1" value="120">
      </div>
      <div class="seg">
        <button class="btn" id="small2">Small ∠ (12°)</button>
        <button class="btn" id="large2">Large ∠ (120°)</button>
      </div>
      <div class="ctl">
        <label>Speed · <span class="val" id="spd2v">1.0×</span></label>
        <input type="range" id="spd2" min="0.1" max="3" step="0.1" value="1">
      </div>
      <div class="seg">
        <button class="btn primary" id="play2">▶ Play</button>
        <button class="btn" id="reset2">↺ Reset</button>
      </div>
    </div>
    <div class="stageM">
      <div class="pane pend">
        <canvas id="pend2"></canvas>
        <div class="bigclock" id="sec2">0.00<small> s</small></div>
      </div>
      <div class="legend" id="legend2"></div>
    </div>
  </section>

  <!-- ================= TAB 3 ================= -->
  <section class="tab" id="t3">
    <div class="controls">
      <div class="ctl">
        <label>Drop angle · <span class="val" id="ang3v">120°</span></label>
        <input type="range" id="ang3" min="5" max="170" step="1" value="120">
      </div>
      <div class="seg">
        <button class="btn" id="small3">Small ∠ (12°)</button>
        <button class="btn" id="large3">Large ∠ (120°)</button>
      </div>
      <div class="ctl">
        <label>Speed · <span class="val" id="spd3v">1.0×</span></label>
        <input type="range" id="spd3" min="0.1" max="3" step="0.1" value="1">
      </div>
      <div class="seg">
        <button class="btn primary" id="play3">▶ Play</button>
        <button class="btn" id="reset3">↺ Reset</button>
      </div>
    </div>
    <div class="stageM">
      <div class="pane pend">
        <canvas id="pend3"></canvas>
        <div class="bigclock" id="sec3">0.00<small> s</small></div>
      </div>
      <div class="legend" id="legend3"></div>
    </div>
  </section>
</main>

<script>
/* ============================================================
   PHYSICS  (shared)  — standard double pendulum, equal m & L
   state s = [θ1, ω1, θ2, ω2]
   ============================================================ */
const G = 9.81;
const P = { L1:1, L2:1, m1:1, m2:1 };
const DT = 1/300;                       // physical timestep (s)

function deriv(s){
  const [th1,w1,th2,w2]=s, {L1,L2,m1,m2}=P;
  const sin=Math.sin, cos=Math.cos;
  const d = th1-th2;
  const den = (2*m1 + m2 - m2*cos(2*th1 - 2*th2));
  const a1 = (-G*(2*m1+m2)*sin(th1) - m2*G*sin(th1-2*th2)
              - 2*sin(d)*m2*(w2*w2*L2 + w1*w1*L1*cos(d))) / (L1*den);
  const a2 = (2*sin(d)*(w1*w1*L1*(m1+m2) + G*(m1+m2)*cos(th1)
              + w2*w2*L2*m2*cos(d))) / (L2*den);
  return [w1, a1, w2, a2];
}
function rk4(s){
  const k1=deriv(s);
  const s2=[s[0]+.5*DT*k1[0],s[1]+.5*DT*k1[1],s[2]+.5*DT*k1[2],s[3]+.5*DT*k1[3]];
  const k2=deriv(s2);
  const s3=[s[0]+.5*DT*k2[0],s[1]+.5*DT*k2[1],s[2]+.5*DT*k2[2],s[3]+.5*DT*k2[3]];
  const k3=deriv(s3);
  const s4=[s[0]+DT*k3[0],s[1]+DT*k3[1],s[2]+DT*k3[2],s[3]+DT*k3[3]];
  const k4=deriv(s4);
  return [
    s[0]+DT/6*(k1[0]+2*k2[0]+2*k3[0]+k4[0]),
    s[1]+DT/6*(k1[1]+2*k2[1]+2*k3[1]+k4[1]),
    s[2]+DT/6*(k1[2]+2*k2[2]+2*k3[2]+k4[2]),
    s[3]+DT/6*(k1[3]+2*k2[3]+2*k3[3]+k4[3]),
  ];
}
function bob(s){
  const x1=P.L1*Math.sin(s[0]), y1=-P.L1*Math.cos(s[0]);
  const x2=x1+P.L2*Math.sin(s[2]), y2=y1-P.L2*Math.cos(s[2]);
  return {x1,y1,x2,y2};
}
const wrap = a => Math.atan2(Math.sin(a), Math.cos(a));   // → [-π,π]
const TRAIL_MAX = 4000;
const REC_MAX = 4200;

/* ============================================================
   SIM
   ============================================================ */
class Sim{
  constructor(kind){
    this.kind = kind;            // 'main' | 'multi'
    this.pend = [];
    this.running = false;
    this.t = 0;
    this.speed = 1;
    this.angleDeg = 120;
    this.trails = true;
    // main
    this.offsetDeg = 1;
    this.hasB = false;
    this.logSep = false;
    this.autoPause = false;
    this.pauseAt = 5;
    this.rec = {t:[], th1:[], th2:[], px:[], py:[], sep:[]};
    // multi
    this.ladder = [0,1,0.1,0.01,0.001];
  }
  makeP(angRad,color,label,ref=false){
    return { s:[angRad,0,angRad,0], color, label, ref, trail:[] };
  }
  reset(autostart=false){
    this.t=0;
    this.rec={t:[],th1:[],th2:[],px:[],py:[],sep:[]};
    const a = this.angleDeg*Math.PI/180;
    if(this.kind==='main'){
      this.pend=[ this.makeP(a, getCSS('--a'), 'A') ];
      if(this.hasB){
        const b=(this.angleDeg+this.offsetDeg)*Math.PI/180;
        this.pend.push(this.makeP(b, getCSS('--b'), 'B'));
      }
    }else{
      const n=this.ladder.length;
      this.pend=this.ladder.map((pct,i)=>{
        const ang=a*(1+pct/100);
        const ref=(i===0);
        const col= ref ? '#ffffff' : `hsl(${(185+(i/(n-1))*150).toFixed(0)} 92% 63%)`;
        return this.makeP(ang, col, fmtPct(pct), ref);
      });
    }
    this.running = autostart;
  }
  step(){
    if(!this.running) return;
    const steps=Math.max(1,Math.round(this.speed*5));
    for(let k=0;k<steps;k++){
      for(const p of this.pend) p.s=rk4(p.s);
      this.t+=DT;
      if(this.kind==='main' && this.autoPause && this.t>=this.pauseAt){
        this.t=this.pauseAt; this.running=false; break;
      }
    }
    // trails (once per frame)
    if(this.trails){
      for(const p of this.pend){
        const b=bob(p.s);
        p.trail.push(b.x2,b.y2);
        if(p.trail.length>TRAIL_MAX*2) p.trail.splice(0,(p.trail.length-TRAIL_MAX*2));
      }
    }
    // recording (main only)
    if(this.kind==='main'){
      const A=this.pend[0], ba=bob(A.s);
      this.rec.t.push(this.t);
      this.rec.th1.push(A.s[0]); this.rec.th2.push(A.s[2]);
      this.rec.px.push(wrap(A.s[0])); this.rec.py.push(wrap(A.s[2]));
      if(this.hasB){
        const B=this.pend[1], bb=bob(B.s);
        const d = Math.hypot(ba.x1-bb.x1,ba.y1-bb.y1) + Math.hypot(ba.x2-bb.x2,ba.y2-bb.y2);
        this.rec.sep.push(d);
      }else this.rec.sep.push(null);
      const r=this.rec;
      if(r.t.length>REC_MAX){const c=r.t.length-REC_MAX;
        r.t.splice(0,c);r.th1.splice(0,c);r.th2.splice(0,c);r.px.splice(0,c);r.py.splice(0,c);r.sep.splice(0,c);}
    }
  }
}

/* ---------- helpers ---------- */
function getCSS(v){return getComputedStyle(document.documentElement).getPropertyValue(v).trim();}
function fmtPct(p){
  if(p===0) return 'original (0%)';
  let s=p.toFixed(10).replace(/0+$/,'').replace(/\.$/,'');
  return s+'%';
}
function fitCanvas(cv){
  const r=cv.getBoundingClientRect();
  const dpr=window.devicePixelRatio||1;
  cv.width=Math.max(1,r.width*dpr); cv.height=Math.max(1,r.height*dpr);
  const ctx=cv.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0);
  return {ctx,w:r.width,h:r.height};
}

/* ---------- pendulum rendering ---------- */
function drawPend(cv, sim){
  const {ctx,w,h}=fitCanvas(cv);
  ctx.clearRect(0,0,w,h);
  // faint backdrop grid
  ctx.strokeStyle=getCSS('--line-soft'); ctx.lineWidth=1;
  for(let x=0;x<w;x+=42){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}
  for(let y=0;y<h;y+=42){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}

  const scale=Math.min(w,h)*0.30;
  const cx=w/2, cy=h*0.30;
  const toX=x=>cx+x*scale, toY=y=>cy-y*scale;
  const multi=(sim.kind==='multi');

  // trails
  for(const p of sim.pend){
    const T=p.trail; if(T.length<4) continue;
    ctx.strokeStyle=p.color; ctx.lineJoin='round';
    ctx.globalAlpha = multi?0.22:0.30; ctx.lineWidth = multi?1.1:1.6;
    ctx.beginPath(); ctx.moveTo(toX(T[0]),toY(T[1]));
    for(let i=2;i<T.length;i+=2) ctx.lineTo(toX(T[i]),toY(T[i+1]));
    ctx.stroke();
    const recent=Math.max(0,T.length-280);
    ctx.globalAlpha = multi?0.6:0.92; ctx.lineWidth = multi?1.5:2.2;
    ctx.beginPath(); ctx.moveTo(toX(T[recent]),toY(T[recent+1]));
    for(let i=recent+2;i<T.length;i+=2) ctx.lineTo(toX(T[i]),toY(T[i+1]));
    ctx.stroke();
  }
  ctx.globalAlpha=1;

  // rods + bobs
  for(const p of sim.pend){
    const b=bob(p.s);
    const x0=toX(0),y0=toY(0),x1=toX(b.x1),y1=toY(b.y1),x2=toX(b.x2),y2=toY(b.y2);
    ctx.strokeStyle=p.color; ctx.lineCap='round';
    ctx.globalAlpha = multi?0.85:1;
    ctx.lineWidth = multi?(p.ref?2.4:1.8):3.2;
    ctx.beginPath(); ctx.moveTo(x0,y0); ctx.lineTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke();
    const r1=multi?3.2:5, r2=multi?4:6.5;
    ctx.fillStyle=p.color;
    ctx.beginPath(); ctx.arc(x1,y1,r1,0,7); ctx.fill();
    ctx.beginPath(); ctx.arc(x2,y2,r2,0,7); ctx.fill();
  }
  ctx.globalAlpha=1;
  // pivot
  ctx.fillStyle='#9fb3cc';
  ctx.beginPath(); ctx.arc(toX(0),toY(0),4,0,7); ctx.fill();
}

/* ---------- generic 2D plot frame ---------- */
function plotFrame(ctx,w,h){
  const pad={l:46,r:12,t:14,b:26};
  ctx.clearRect(0,0,w,h);
  ctx.fillStyle='rgba(255,255,255,0.015)';
  ctx.fillRect(pad.l,pad.t,w-pad.l-pad.r,h-pad.t-pad.b);
  return pad;
}
function gridLine(ctx,x1,y1,x2,y2){ctx.strokeStyle=getCSS('--line-soft');ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();}
function axLabel(ctx,txt,x,y,align='left',color){ctx.fillStyle=color||getCSS('--muted');
  ctx.font='10px '+getCSS('--mono');ctx.textAlign=align;ctx.fillText(txt,x,y);}

function drawTime(cv,sim){
  const {ctx,w,h}=fitCanvas(cv); const pad=plotFrame(ctx,w,h);
  const r=sim.rec; const n=r.t.length;
  const ix=pad.l, iy=pad.t, iw=w-pad.l-pad.r, ih=h-pad.t-pad.b;
  if(n<2){axLabel(ctx,'press Play…',ix+iw/2,iy+ih/2,'center');return;}
  const t0=r.t[0], t1=r.t[n-1];
  let ymin=Infinity,ymax=-Infinity;
  for(let i=0;i<n;i++){ymin=Math.min(ymin,r.th1[i],r.th2[i]);ymax=Math.max(ymax,r.th1[i],r.th2[i]);}
  if(ymax-ymin<0.2){ymin-=0.5;ymax+=0.5;}
  const padY=(ymax-ymin)*0.08; ymin-=padY; ymax+=padY;
  const X=t=>ix+(t-t0)/Math.max(1e-6,t1-t0)*iw;
  const Y=v=>iy+ih-(v-ymin)/(ymax-ymin)*ih;
  // zero line + grid
  for(let g=0;g<=4;g++){const yy=iy+ih*g/4;gridLine(ctx,ix,yy,ix+iw,yy);}
  if(ymin<0&&ymax>0){ctx.strokeStyle='rgba(150,180,210,0.25)';ctx.beginPath();ctx.moveTo(ix,Y(0));ctx.lineTo(ix+iw,Y(0));ctx.stroke();}
  const series=(arr,color)=>{ctx.strokeStyle=color;ctx.lineWidth=1.8;ctx.beginPath();
    ctx.moveTo(X(r.t[0]),Y(arr[0]));for(let i=1;i<n;i++)ctx.lineTo(X(r.t[i]),Y(arr[i]));ctx.stroke();};
  series(r.th1,getCSS('--a')); series(r.th2,getCSS('--amber'));
  axLabel(ctx,'θ (rad)',6,iy+10);
  axLabel(ctx,'t = '+t1.toFixed(1)+'s',ix+iw,h-8,'right');
  axLabel(ctx,'θ₁',ix+8,iy+12,'left',getCSS('--a'));
  axLabel(ctx,'θ₂',ix+30,iy+12,'left',getCSS('--amber'));
}

const SUP={'-':'⁻','0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹'};
const sup=n=>String(n).split('').map(c=>SUP[c]||c).join('');

function drawPhase(cv,sim){
  const {ctx,w,h}=fitCanvas(cv); const pad=plotFrame(ctx,w,h);
  const r=sim.rec; const n=r.px.length;
  const ix=pad.l, iy=pad.t, iw=w-pad.l-pad.r, ih=h-pad.t-pad.b;
  for(let g=0;g<=4;g++){const yy=iy+ih*g/4,xx=ix+iw*g/4;gridLine(ctx,ix,yy,ix+iw,yy);gridLine(ctx,xx,iy,xx,iy+ih);}
  axLabel(ctx,'θ₁ →',ix+iw,h-8,'right'); axLabel(ctx,'θ₂',6,iy+12);
  if(n<2){axLabel(ctx,'press Play…',ix+iw/2,iy+ih/2,'center');return;}
  // auto-scale to the data so the pattern fills the box (handles small & large angles)
  let xmin=Infinity,xmax=-Infinity,ymin=Infinity,ymax=-Infinity;
  for(let i=0;i<n;i++){const a=r.px[i],b=r.py[i];
    if(a<xmin)xmin=a;if(a>xmax)xmax=a;if(b<ymin)ymin=b;if(b>ymax)ymax=b;}
  const dx=(xmax-xmin)||1, dy=(ymax-ymin)||1;
  xmin-=dx*0.07;xmax+=dx*0.07;ymin-=dy*0.07;ymax+=dy*0.07;
  const sc=Math.min(iw/(xmax-xmin), ih/(ymax-ymin));   // equal scale → undistorted shape
  const cxD=(xmin+xmax)/2, cyD=(ymin+ymax)/2;
  const X=v=>ix+iw/2+(v-cxD)*sc;
  const Y=v=>iy+ih/2-(v-cyD)*sc;
  ctx.save();ctx.beginPath();ctx.rect(ix,iy,iw,ih);ctx.clip();
  ctx.strokeStyle=getCSS('--accent');ctx.lineWidth=1.3;ctx.lineJoin='round';ctx.globalAlpha=.9;ctx.beginPath();
  let started=false;
  for(let i=1;i<n;i++){
    if(Math.abs(r.px[i]-r.px[i-1])>Math.PI || Math.abs(r.py[i]-r.py[i-1])>Math.PI){started=false;continue;}
    const x=X(r.px[i]),y=Y(r.py[i]);
    if(!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y);
  }
  ctx.stroke();ctx.globalAlpha=1;
  ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(X(r.px[n-1]),Y(r.py[n-1]),3.2,0,7);ctx.fill();
  ctx.restore();
}

function drawSep(cv,sim){
  const {ctx,w,h}=fitCanvas(cv); const pad=plotFrame(ctx,w,h);
  const r=sim.rec;
  const ix=pad.l, iy=pad.t, iw=w-pad.l-pad.r, ih=h-pad.t-pad.b;
  if(!sim.hasB){axLabel(ctx,'＋ add 2nd pendulum to measure divergence',ix+iw/2,iy+ih/2,'center');return;}
  const n=r.t.length; if(n<2){axLabel(ctx,'press Play…',ix+iw/2,iy+ih/2,'center');return;}
  // FIXED scales: window of W seconds scrolls left; data exits the frame, never compressed
  const W=12;
  const t1=r.t[n-1], tEnd=Math.max(W,t1), t0=tEnd-W;
  const X=t=>ix+(t-t0)/W*iw;
  const yLo=1e-3, yHi=10, lo=Math.log10(yLo), hi=Math.log10(yHi);
  const Y=v=>{const c=Math.min(Math.max(v,yLo),yHi);return iy+ih-(Math.log10(c)-lo)/(hi-lo)*ih;};
  for(let e=Math.ceil(lo); e<=Math.floor(hi); e++){
    const yy=Y(Math.pow(10,e)); gridLine(ctx,ix,yy,ix+iw,yy);
    axLabel(ctx,'10'+sup(e),ix-3,yy+3,'right');
  }
  ctx.save();ctx.beginPath();ctx.rect(ix,iy,iw,ih);ctx.clip();
  ctx.strokeStyle=getCSS('--b');ctx.lineWidth=1.9;ctx.lineJoin='round';ctx.beginPath();let st=false;
  for(let i=0;i<n;i++){const v=r.sep[i];if(v==null)continue;const x=X(r.t[i]),y=Y(v);
    if(!st){ctx.moveTo(x,y);st=true;}else ctx.lineTo(x,y);}
  ctx.stroke();ctx.restore();
  axLabel(ctx,'Σ distance (log)',ix,iy-2,'left');
  axLabel(ctx,'t = '+t1.toFixed(1)+'s',ix+iw,h-8,'right');
}

/* ============================================================
   WIRING
   ============================================================ */
const sims = { t1:new Sim('main'), t2:new Sim('multi'), t3:new Sim('multi') };
sims.t2.ladder=[0,1,0.1,0.01,0.001];
sims.t3.ladder=[0,1,0.1,0.01,0.001,1e-4,1e-5,1e-6,1e-7,1e-8];
let active='t1';

function buildLegend(id,sim){
  const el=document.getElementById(id); el.innerHTML='<h3>Initial-angle offset</h3>';
  for(const p of sim.pend){
    const row=document.createElement('div');row.className='leg-item';
    row.innerHTML=`<span class="swatch" style="background:${p.color}"></span><span>${p.label}</span>`;
    el.appendChild(row);
  }
}

/* tabs */
document.querySelectorAll('.tab-btn').forEach(b=>b.onclick=()=>{
  active=b.dataset.tab;
  document.querySelectorAll('.tab-btn').forEach(x=>x.classList.toggle('active',x===b));
  document.querySelectorAll('.tab').forEach(s=>s.classList.toggle('active',s.id===active));
});

/* generic control binding for a sim */
function bind(tab, sim, opts){
  const $=id=>document.getElementById(id);
  const playBtn=$('play'+tab);
  const setPlay=()=>{playBtn.textContent=sim.running?'❚❚ Pause':'▶ Play';
    playBtn.classList.toggle('primary',!sim.running);};
  playBtn.onclick=()=>{ sim.running=!sim.running; setPlay(); };
  $('reset'+tab).onclick=()=>{ sim.reset(false); if(opts.legend)buildLegend(opts.legend,sim); setPlay(); };

  const ang=$('ang'+tab), angv=$('ang'+tab+'v');
  ang.addEventListener('input',()=>{angv.textContent=ang.value+'°';});
  ang.addEventListener('change',()=>{sim.angleDeg=+ang.value;sim.reset(false);if(opts.legend)buildLegend(opts.legend,sim);setPlay();});

  const small=$('small'+tab), large=$('large'+tab);
  if(small) small.onclick=()=>{ang.value=12;angv.textContent='12°';sim.angleDeg=12;sim.reset(false);if(opts.legend)buildLegend(opts.legend,sim);setPlay();};
  if(large) large.onclick=()=>{ang.value=120;angv.textContent='120°';sim.angleDeg=120;sim.reset(false);if(opts.legend)buildLegend(opts.legend,sim);setPlay();};

  const spd=$('spd'+tab), spdv=$('spd'+tab+'v');
  if(spd) spd.addEventListener('input',()=>{sim.speed=+spd.value;spdv.textContent=(+spd.value).toFixed(1)+'×';});

  const tr=$('trail'+tab);
  if(tr) tr.onclick=()=>{sim.trails=!sim.trails;tr.textContent='Trails: '+(sim.trails?'On':'Off');
    tr.classList.toggle('on',sim.trails); if(!sim.trails)sim.pend.forEach(p=>p.trail=[]);};
}

/* tab1 extra controls */
sims.t1.logSep = true;            // separation graph always log
bind('1',sims.t1,{});
(function(){
  const $=id=>document.getElementById(id);
  const off=$('off1'),offv=$('off1v');
  off.addEventListener('input',()=>{offv.textContent=(+off.value).toFixed(3)+'°';});
  off.addEventListener('change',()=>{sims.t1.offsetDeg=+off.value;sims.t1.reset(false);refreshPlay1();});
  const spawn=$('spawn1');
  spawn.onclick=()=>{sims.t1.hasB=!sims.t1.hasB;
    spawn.textContent=sims.t1.hasB?'－ Remove 2nd Pendulum':'＋ Add 2nd Pendulum';
    spawn.classList.toggle('on',sims.t1.hasB);
    sims.t1.reset(false);refreshPlay1();};
  const at=$('autotog1');
  at.onclick=()=>{sims.t1.autoPause=!sims.t1.autoPause;at.textContent=sims.t1.autoPause?'On':'Off';at.classList.toggle('on',sims.t1.autoPause);};
  $('pauseat1').addEventListener('change',e=>{sims.t1.pauseAt=Math.max(0.5,+e.target.value||5);});
})();
function refreshPlay1(){const b=document.getElementById('play1');b.textContent=sims.t1.running?'❚❚ Pause':'▶ Play';b.classList.toggle('primary',!sims.t1.running);}

bind('2',sims.t2,{legend:'legend2'});
bind('3',sims.t3,{legend:'legend3'});

/* init */
sims.t1.reset(false);
sims.t2.reset(false); buildLegend('legend2',sims.t2);
sims.t3.reset(false); buildLegend('legend3',sims.t3);

/* main loop */
function loop(){
  const sim=sims[active];
  sim.step();
  if(active==='t1'){
    drawPend(document.getElementById('pend1'),sim);
    drawPhase(document.getElementById('gPhase'),sim);
    drawSep(document.getElementById('gSep'),sim);
    document.getElementById('sec1').textContent=sim.t.toFixed(2)+' s';
    refreshPlay1();
  }else{
    const pid='pend'+active.slice(1), sid='sec'+active.slice(1);
    drawPend(document.getElementById(pid),sim);
    document.getElementById(sid).innerHTML=sim.t.toFixed(2)+'<small> s</small>';
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>
