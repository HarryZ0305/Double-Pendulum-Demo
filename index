<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Double Pendulum — Chaos Demos</title>
<style>
  :root{
    --bg:#070a10;
    --panel:#0c121f;
    --panel-2:#0f1626;
    --line:#1c2942;
    --line-soft:rgba(120,160,200,0.10);
    --txt:#d4ddec;
    --muted:#6f8099;
    --accent:#2ee6c4;
    --a:#34e7e0;   /* pendulum A / cyan */
    --b:#ff5c8a;   /* pendulum B / magenta */
    --amber:#ffce5c;
    --mono:'JetBrains Mono','SF Mono',ui-monospace,'Cascadia Code',Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:
      radial-gradient(1200px 600px at 50% -10%, #0f1830 0%, transparent 60%),
      repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,0.012) 3px 4px),
      var(--bg);
    color:var(--txt);
    font-family:var(--mono);
    -webkit-font-smoothing:antialiased;
    display:flex;flex-direction:column;height:100vh;overflow:hidden;
  }
  header{
    padding:14px 22px 0 22px;flex:0 0 auto;
  }
  .titlebar{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap}
  h1{
    margin:0;font-size:19px;font-weight:700;letter-spacing:3px;text-transform:uppercase;
    color:#eef4ff;
  }
  h1 .dot{color:var(--accent)}
  .sub{font-size:11px;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase}
  .tabs{display:flex;gap:8px;margin-top:14px}
  .tab-btn{
    font-family:var(--mono);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;
    background:var(--panel);color:var(--muted);border:1px solid var(--line);
    padding:10px 18px;border-radius:9px 9px 0 0;cursor:pointer;transition:.15s;
    border-bottom:none;
  }
  .tab-btn:hover{color:var(--txt)}
  .tab-btn.active{background:var(--panel-2);color:var(--accent);box-shadow:inset 0 2px 0 var(--accent)}
  main{flex:1 1 auto;min-height:0;padding:0 22px 18px;display:flex}
  .tab{display:none;flex:1;min-height:0;flex-direction:column;
    background:var(--panel-2);border:1px solid var(--line);border-radius:0 12px 12px 12px;padding:16px;}
  .tab.active{display:flex}

  /* controls */
  .controls{display:flex;gap:18px 22px;flex-wrap:wrap;align-items:flex-end;
    padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid var(--line);flex:0 0 auto}
  .ctl{display:flex;flex-direction:column;gap:5px}
  .ctl label{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted)}
  .ctl .val{color:var(--accent)}
  input[type=range]{width:150px;accent-color:var(--accent);cursor:pointer}
  .btn{
    font-family:var(--mono);font-size:11px;letter-spacing:1.2px;text-transform:uppercase;
    background:var(--panel);color:var(--txt);border:1px solid var(--line);
    padding:9px 14px;border-radius:8px;cursor:pointer;transition:.15s;white-space:nowrap}
  .btn:hover{border-color:var(--accent);color:#fff}
  .btn.primary{background:var(--accent);color:#062019;border-color:var(--accent);font-weight:700}
  .btn.primary:hover{filter:brightness(1.08)}
  .btn.on{border-color:var(--accent);color:var(--accent)}
  .seg{display:flex;gap:6px}
  .num{width:62px;background:var(--panel);border:1px solid var(--line);color:var(--txt);
    font-family:var(--mono);padding:8px;border-radius:8px}
  .toggle-row{display:flex;align-items:center;gap:9px}
  .toggle-row .btn{padding:8px 12px}

  /* stages */
  .stage1{flex:1;min-height:0;display:grid;grid-template-columns:1.05fr 0.95fr;gap:14px}
  .stageM{flex:1;min-height:0;display:grid;grid-template-columns:1fr 248px;gap:14px}
  .pane{background:var(--panel);border:1px solid var(--line);border-radius:10px;position:relative;overflow:hidden}
  .pane.pend{min-height:0}
  canvas{display:block;width:100%;height:100%}
  .pane-tag{position:absolute;top:9px;left:11px;font-size:10px;letter-spacing:1.5px;
    text-transform:uppercase;color:var(--muted);pointer-events:none;z-index:2}
  .graphcol{display:grid;grid-template-rows:1.95fr 1fr;gap:14px;min-height:0}
  .graphcol .pane{min-height:0}

  /* overlays */
  .clock{position:absolute;top:9px;right:13px;font-size:13px;letter-spacing:1px;color:var(--accent);z-index:2}
  .bigclock{position:absolute;bottom:12px;right:16px;font-size:30px;font-weight:700;
    letter-spacing:1px;color:#fff;text-shadow:0 0 18px rgba(46,230,196,.4);z-index:2}
  .bigclock small{font-size:13px;color:var(--muted);font-weight:400}

  /* legend */
  .legend{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;
    display:flex;flex-direction:column;gap:2px;overflow:auto}
  .legend h3{margin:0 0 10px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted)}
  .leg-item{display:flex;align-items:center;gap:10px;padding:5px 0;font-size:12px}
  .swatch{width:16px;height:4px;border-radius:2px;flex:0 0 auto}
  .leg-note{margin-top:auto;padding-top:12px;font-size:10px;line-height:1.5;color:var(--muted)}
  .hint{font-size:10px;color:var(--muted);letter-spacing:.5px;margin-top:10px;line-height:1.5}
  .hint b{color:var(--accent);font-weight:600}
  .pill{display:inline-block;padding:2px 7px;border:1px solid var(--line);border-radius:6px;color:var(--muted);font-size:10px}
</style>
</head>
<body>
<header>
  <div class="titlebar">
    <h1>Double Pendulum Demo</h1>
  </div>
  <div class="tabs">
    <button class="tab-btn active" data-tab="t1">01 · Two Pendulums</button>
    <button class="tab-btn" data-tab="t2">02 · Five Pendulums</button>
    <button class="tab-btn" data-tab="t3">03 · Ten Pendulums</button>
  </div>
</header>

<main>
  <!-- ================= TAB 1 ================= -->
  <section class="tab active" id="t1">
    <div class="controls">
      <div class="ctl">
        <label>θ₁ · <span class="val" id="ang1v">120°</span></label>
